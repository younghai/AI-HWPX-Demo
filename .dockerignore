# Reinstalled / rebuilt inside the image
node_modules
**/node_modules
client/dist
.venv
**/.venv

# Never bake secrets into the image (passed at runtime instead)
.env
.env.*
server/.env

# Machine-specific pnpm store path — would create a phantom /Users dir in the
# builder stage (same class as the CI EACCES; see docs/lessons-learned.md)
.npmrc

# Runtime output / local state
generated
.work
*.log
.omc

# VCS / editor / OS noise
.git
.github
.DS_Store
.idea
.vscode
