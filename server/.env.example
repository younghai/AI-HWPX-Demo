# ── AI Provider API Keys ─────────────────────────────────────
# 최소 1개는 필요 (UI 우측 상단 '프로바이더 설정'에서 입력해도 됨 → 이 파일에 자동 저장)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=

# ── OAuth Client Credentials (선택) ──────────────────────────
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
KIMI_CLIENT_ID=
KIMI_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# ── Google 로그인 (선택 — 비우면 mock 로그인으로 동작) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 서버 설정 (선택 — 기본값으로 충분) ────────────────────────
# PORT=8792
# CLIENT_ORIGIN=http://127.0.0.1:5192

# ── 배포 보안 (외부 공개 시 필수) ────────────────────────────
# AUTH_MODE=local(기본) 은 인증 없이 동작(로컬 단일 사용자용).
# 외부/팀 배포 시 protected 로 설정하면 상태 변경·비용·다운로드 라우트에
# Google 로그인 세션을 강제한다. protected 는 GOOGLE_CLIENT_ID/SECRET 필요.
# AUTH_MODE=protected
# NODE_ENV=production            # mock 로그인 완전 비활성 + 쿠키 secure(HTTPS)

# 산출물 자동 정리(선택). 기본 24h TTL / 500MB.
# GENERATED_TTL_MS=86400000
# GENERATED_MAX_BYTES=524288000
