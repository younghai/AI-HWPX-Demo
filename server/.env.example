# ── AI Provider API Keys ─────────────────────────────────────
# 최소 1개는 필요 (UI 우측 상단 '프로바이더 설정'에서 입력해도 됨 → 이 파일에 자동 저장)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=

# ── OAuth Client Credentials (선택) ──────────────────────────
OPENAI_CLIENT_ID=
OPENAI_CLIENT_SECRET=
KIMI_CLIENT_ID=
KIMI_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=

# ── Google 로그인 (선택 — 비우면 mock 로그인으로 동작) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 서버 설정 (선택 — 기본값으로 충분) ────────────────────────
